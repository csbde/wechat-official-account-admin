# 服务监听端口
WOAA_SERVER_PORT=9305
WOAA_SERVER_MODE=debug

# PostgreSQL 数据库配置
WOAA_DATABASE_HOST=127.0.0.1
WOAA_DATABASE_PORT=5432
WOAA_DATABASE_USER=sc
WOAA_DATABASE_PASSWORD=sc
WOAA_DATABASE_DBNAME=woaa
WOAA_DATABASE_SSLMODE=disable

# Redis 缓存配置
WOAA_REDIS_ADDR=127.0.0.1:6379
WOAA_REDIS_PASSWORD=sc
WOAA_REDIS_DB=0

# JWT 配置
WOAA_JWT_SECRET=woaa-super-secure-jwt-token-secret-2025
WOAA_JWT_EXPIRE_HOURS=72

# 微信与服务公网地址 (可不填，自动取请求 Host)
WOAA_WECHAT_PUBLIC_HOST=
WOAA_WECHAT_PROXY=
